		},
		"wQPSot93MLJHToXyQ1DZ-9": {
			"path": "wQPSot93MLJHToXyQ1DZ-9",
			"cellId": "wQPSot93MLJHToXyQ1DZ-9",
			"visible": true,
			"parentCellId": "wQPSot93MLJHToXyQ1DZ-1"
		},
		"lib/alarm.dart-d8f7585e-b5c0-4d34-b06f-678f4073900c-ac4e20e1-52a2-4d52-a87d-2b1b0e25c470-f88d41ae-b519-44c1-b7e6-452f49422d9a": {
			"path": "lib/alarm.dart-d8f7585e-b5c0-4d34-b06f-678f4073900c-ac4e20e1-52a2-4d52-a87d-2b1b0e25c470-f88d41ae-b519-44c1-b7e6-452f49422d9a",
			"fileName": "alarm.dart",
			"wiki": "<h3>Breakdown of the Loop:</h3><p><strong>Iteration through Alarms</strong>:<br>The loop iterates through each alarm in the alarms list, which represents all previously saved alarms retrieved from storage.</p><p><strong>Get Current Time</strong>:<br>final now = DateTime.now(); retrieves the current date and time. This is crucial for determining whether each saved alarm's scheduled time is in the future or has already passed.</p><p><strong>Check Scheduled Time</strong>:</p><ul><li><strong>Future Alarm Check</strong>: if (alarm.dateTime.isAfter(now)) checks if the alarm's scheduled time (alarm.dateTime) is after the current time (now).<ul><li>If true, it means the alarm is still in the future, and the code calls the set method to re-schedule this alarm for ringing.</li></ul></li><li><strong>Past Alarm Handling</strong>: If the alarm is not in the future:<ul><li>An inner check if (await Alarm.isRinging(alarm.id)) determines if this specific alarm is currently ringing.<ul><li>If the alarm is ringing, it adds this alarm to the _ringing BehaviorSubject, indicating that this alarm is active and should be treated as a ringing alarm.</li><li>It also pushes an update to ringStream, notifying listeners that this alarm is ringing.</li></ul></li><li>If the alarm is not ringing, it asynchronously calls stop(alarm.id) to ensure that the alarm is turned off, indicating it is no longer valid or necessary.</li></ul></li></ul><h3>Summary</h3><p>In essence, this loop serves to:</p><ul><li>Reschedule alarms that are meant to ring in the future.</li><li>Handle ringing alarms that are already ongoing, ensuring that their state is reflected in the system.</li><li>Stop any alarms that were supposed to ring in the past but are not currently active.</li></ul><h3>Example Scenario</h3><p>Imagine the app was terminated with the following saved alarms in storage:</p><ul><li>Alarm A (scheduled for tomorrow)</li><li>Alarm B (scheduled for yesterday and is currently ringing)</li><li>Alarm C (scheduled for a few days later)</li></ul><p>When checkAlarm is invoked:</p><ul><li>The app will reschedule Alarm A.</li><li>For Alarm B, since it's already ringing, it'll be added to the ringing alarms and notified.</li><li>For Alarm C, since it’s set for the future, it will also be rescheduled.</li></ul><p>This logic ensures that the app maintains a correct and updated state of alarms whenever it is restarted.</p><p>&nbsp;</p>",
			"cellName": "processExistingAlarms",
			"cellId": "lib/alarm.dart-d8f7585e-b5c0-4d34-b06f-678f4073900c-ac4e20e1-52a2-4d52-a87d-2b1b0e25c470-f88d41ae-b519-44c1-b7e6-452f49422d9a",
			"visible": true,
			"startLine": "72",
			"endLine": "84",
			"parentCellId": "wQPSot93MLJHToXyQ1DZ-1",
			"parentPath": "lib/alarm.dart"
		},
		"lib/alarm.dart#L30-L63": {
			"path": "lib/alarm.dart#L30-L63",
			"fileName": "alarm.dart",
			"wiki": "<h3>Breakdown of the Loop:</h3><p><strong>Iteration through Alarms</strong>:<br>The loop iterates through each alarm in the alarms list, which represents all previously saved alarms retrieved from storage.</p><p><strong>Get Current Time</strong>:<br>final now = DateTime.now(); retrieves the current date and time. This is crucial for determining whether each saved alarm's scheduled time is in the future or has already passed.</p><p><strong>Check Scheduled Time</strong>:</p><ul><li><strong>Future Alarm Check</strong>: if (alarm.dateTime.isAfter(now)) checks if the alarm's scheduled time (alarm.dateTime) is after the current time (now).<ul><li>If true, it means the alarm is still in the future, and the code calls the set method to re-schedule this alarm for ringing.</li></ul></li><li><strong>Past Alarm Handling</strong>: If the alarm is not in the future:<ul><li>An inner check if (await Alarm.isRinging(alarm.id)) determines if this specific alarm is currently ringing.<ul><li>If the alarm is ringing, it adds this alarm to the _ringing BehaviorSubject, indicating that this alarm is active and should be treated as a ringing alarm.</li><li>It also pushes an update to ringStream, notifying listeners that this alarm is ringing.</li></ul></li><li>If the alarm is not ringing, it asynchronously calls stop(alarm.id) to ensure that the alarm is turned off, indicating it is no longer valid or necessary.</li></ul></li></ul><h3>Summary</h3><p>In essence, this loop serves to:</p><ul><li>Reschedule alarms that are meant to ring in the future.</li><li>Handle ringing alarms that are already ongoing, ensuring that their state is reflected in the system.</li><li>Stop any alarms that were supposed to ring in the past but are not currently active.</li></ul><h3>Example Scenario</h3><p>Imagine the app was terminated with the following saved alarms in storage:</p><ul><li>Alarm A (scheduled for tomorrow)</li><li>Alarm B (scheduled for yesterday and is currently ringing)</li><li>Alarm C (scheduled for a few days later)</li></ul><p>When checkAlarm is invoked:</p><ul><li>The app will reschedule Alarm A.</li><li>For Alarm B, since it's already ringing, it'll be added to the ringing alarms and notified.</li><li>For Alarm C, since it’s set for the future, it will also be rescheduled.</li></ul><p>This logic ensures that the app maintains a correct and updated state of alarms whenever it is restarted.</p><p>&nbsp;</p>",
			"cellName": "processExistingAlarms",
			"cellId": "lib/alarm.dart-d8f7585e-b5c0-4d34-b06f-678f4073900c-ac4e20e1-52a2-4d52-a87d-2b1b0e25c470-f88d41ae-b519-44c1-b7e6-452f49422d9a",
			"visible": true,
